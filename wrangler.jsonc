{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edlaw-thamdee",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "edlaw.thamdee.com",
      "custom_domain": true
    }
  ]
}
